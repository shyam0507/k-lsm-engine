{
  "id": null,
  "uid": "klsm-engine",
  "title": "k-lsm-engine",
  "tags": [
    "klsm"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "op",
        "label": "op",
        "type": "custom",
        "query": "put,delete,get",
        "current": {
          "text": "put",
          "value": "put"
        },
        "options": [
          {
            "text": "put",
            "value": "put",
            "selected": true
          },
          {
            "text": "delete",
            "value": "delete",
            "selected": false
          },
          {
            "text": "get",
            "value": "get",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "flush",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "increase(klsm_flush_total[$__interval]) > 0",
        "titleFormat": "flush",
        "step": "5s"
      },
      {
        "name": "compaction",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "increase(klsm_compaction_total[$__interval]) > 0",
        "titleFormat": "compaction",
        "step": "5s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request latency by method (what the client sees)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, method) (rate(klsm_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{method}}",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(klsm_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{method}}",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, method) (rate(klsm_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{method}}",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method) (rate(klsm_http_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "D",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Time per request by stage, op=$op (stacked)",
      "description": "Mean seconds each stage contributes to one request. The widest band is the bottleneck. Nested stages (wal_fsync inside wal_append, sstable_lock_wait inside sstable_read) are excluded so the stack adds up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (rate(klsm_stage_duration_seconds_sum{op=\"$op\", stage!~\"wal_fsync|sstable_lock_wait\"}[$__rate_interval])) / scalar(sum(rate(klsm_http_request_duration_seconds_count{method=~\"(?i)$op\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Stage share of request time, op=$op",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (rate(klsm_stage_duration_seconds_sum{op=\"$op\", stage!~\"wal_fsync|sstable_lock_wait\"}[$__rate_interval])) / scalar(sum(rate(klsm_http_request_duration_seconds_count{method=~\"(?i)$op\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
